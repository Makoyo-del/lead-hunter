# Hardened Security & Direct Routing Configuration for Hostinger Audits Directory
# Duncan Makoyo Catalog X-Ray Pipeline

# Disable mod_rewrite inheritance from root SPA so static audit pages load directly
<IfModule mod_rewrite.c>
    RewriteEngine Off
</IfModule>

# Ensure directory index looks for index.html first
DirectoryIndex index.html index.php

# Disable directory browsing
Options -Indexes

# Block access to log files, git, environment configs, and sensitive files
<FilesMatch "\.(jsonl|log|git|env|ini|sh|bak)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block access to hidden dotfiles (e.g. .git, .audits_events_log.jsonl, .events_log.jsonl)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Enforce UTF-8 charset
AddDefaultCharset UTF-8

# MIME Types for Excel & CSV Deliverables
AddType application/vnd.openxmlformats-officedocument.spreadsheetml.sheet .xlsx
AddType text/csv .csv
AddCharset utf-8 .csv

# Force direct browser file download for .xlsx and .csv
<FilesMatch "\.(csv|xlsx)$">
    <IfModule mod_headers.c>
        Header set Content-Disposition "attachment"
        Header set X-Content-Type-Options "nosniff"
    </IfModule>
</FilesMatch>
